<Window x:Class="AzureHoard.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Azure Hoard" Width="340" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        DragOver="Window_DragOver" Drop="Window_Drop">

  <Window.Resources>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="6" Background="Transparent" Margin="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="#44FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" CornerRadius="12" Background="#B30C1438" BorderBrush="#4D7FC8FF" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border x:Name="TitleBar" Grid.Row="0" Background="#33FFFFFF" CornerRadius="11,11,0,0"
              MouseLeftButtonDown="Title_Down" MouseRightButtonUp="Title_Right">
        <Grid>
          <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" FontSize="13"
                     VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
          <TextBox x:Name="TitleEdit" Visibility="Collapsed" Margin="8,4" Padding="4,0"
                   Background="#66000000" Foreground="White" CaretBrush="White" BorderThickness="0"
                   VerticalContentAlignment="Center" LostFocus="TitleEdit_Lost" KeyDown="TitleEdit_Key"/>
        </Grid>
      </Border>

      <ListBox x:Name="ItemList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="4"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
               PreviewMouseLeftButtonDown="List_PreviewDown" PreviewMouseMove="List_PreviewMove"
               MouseDoubleClick="List_DoubleClick" PreviewMouseRightButtonUp="List_Right">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="76" Margin="2" Background="Transparent" ToolTip="{Binding Path}">
              <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,4,0,2"/>
              <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" TextAlignment="Center"
                         TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Thumb x:Name="Grip" Grid.Row="1" Width="16" Height="16" HorizontalAlignment="Right"
             VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Grip_Delta">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Path Data="M14,2 L14,14 L2,14 Z" Fill="#80FFFFFF"/>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
